      "y": 3,
      "w": 44,
      "h": 4,
      "text": "FRESH MARKET",
      "fontSize": 2.2,
      "fill": "#526158",
      "bold": true,
      "align": "center",
      "verticalAlign": "middle"
    },
    {
      "id": "centered-product",
      "type": "fitText",
